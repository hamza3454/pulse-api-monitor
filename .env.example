# Copy to .env for local overrides (.env is git-ignored).
# Every value below is optional; the defaults match docker-compose.yml.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# --- Pulse services (read by backend/internal/config) ---
PULSE_HTTP_ADDR=:8080
PULSE_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable
PULSE_LOG_LEVEL=info   # debug | info | warn | error
PULSE_CORS_ORIGIN=http://localhost:5173   # browser origin allowed to call the API (the React dev server)

# --- Tests ---
# Enables the Postgres integration tests. Each test run creates and drops its
# own throwaway schema, so it is safe to point at your development database.
PULSE_TEST_DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable
